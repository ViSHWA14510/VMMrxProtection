{
  "rewrites": [
    {
      "source": "/api/generate",
      "destination": "/api/generate"
    },
    {
      "source": "/api/verify",
      "destination": "/api/verify"
    },
    {
      "source": "/api/direct",
      "destination": "/api/direct"
    },
    {
      "source": "/api/track",
      "destination": "/api/track"
    },
    {
      "source": "/api/stats",
      "destination": "/api/stats"
    },
    {
      "source": "/token/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/s/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/stats",
      "destination": "/stats.html"
    },
    {
      "source": "/((?!api|token|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
