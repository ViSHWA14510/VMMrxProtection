{
  "rewrites": [
    { "source": "/api/generate", "destination": "/api/generate" },
    { "source": "/api/verify", "destination": "/api/verify" },
    { "source": "/token/(.*)", "destination": "/index.html" },
    {
      "source": "/((?!api|token|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
