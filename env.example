# ── Telegram ───────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ── Cloudflare Worker (link protection backend) ────────────────────────────────
# Your deployed Worker URL (no trailing slash)
WORKER_URL=https://your-worker.workers.dev
# Same secret you set via: wrangler secret put ADMIN_SECRET
ADMIN_SECRET=your_admin_secret_here

# ── Bot Admin Telegram User IDs ────────────────────────────────────────────────
ADMIN_IDS=123456789,987654321

# ── Optional: force-subscribe channel ──────────────────────────────────────────
# FORCE_SUB_CHANNEL=@yourchannel

# ── /start screen branding ─────────────────────────────────────────────────────
# BANNER_IMAGE_URL=https://example.com/banner.jpg
# BOT_NAME=VMMrx Protection
# MAINTAINER_NAME=VMMrx Developer
# UPDATES_URL=https://t.me/your_updates_channel
# SUPPORT_URL=https://t.me/your_support_group
# DASHBOARD_URL=   (leave unset — Dashboard shows a placeholder until you set this)

# ── SQLite DB path ─────────────────────────────────────────────────────────────
# DB_PATH=/opt/render/project/src/vmmrx_bot.db
