# ── Telegram ──────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# ── Your Vercel deployment URL ─────────────────────────────────────────────────
# Example: https://vmmrx-protection.vercel.app
SITE_URL=https://your-vercel-app.vercel.app

# ── VMMrx API admin key ────────────────────────────────────────────────────────
# This is your ADMIN_KEY from your Vercel environment variables
ADMIN_KEY=your_admin_key_here

# ── Bot Admin Telegram User IDs ────────────────────────────────────────────────
# Comma-separated list of Telegram user IDs who can approve/revoke users
# Get your ID from @userinfobot on Telegram
ADMIN_IDS=123456789,987654321

# ── SQLite DB path (optional, auto-set on Render) ─────────────────────────────
# DB_PATH=/opt/render/project/src/vmmrx_bot.db
